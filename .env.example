# Copy to .env and fill in. Never commit .env.

# Live mode: your Anthropic API key (read from the environment only).
ANTHROPIC_API_KEY=

# Optional: override the model id used for capture and check.
# SCAR_MODEL=

# Mock mode: set to 1 to use built-in fixtures instead of the API (no key needed).
# The demo scripts set this for you.
# SCAR_MOCK=1

# Dashboard: which repository's .scars folder to read (default: ./demo-repo).
# SCAR_REPO=/path/to/your/repo
